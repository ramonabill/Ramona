
import React, { useMemo, useState } from "react";
import { Card, CardContent } from "@/components/ui/card";
import { Button } from "@/components/ui/button";

export default function JeepJLUGearRatioCalculator() {
  const [tire, setTire] = useState(35);
  const [currentRatio, setCurrentRatio] = useState(3.75);
  const [rpm, setRpm] = useState(2200);
  const [transRatio, setTransRatio] = useState(0.67);
  const ratios = [3.45, 3.73, 4.10, 4.56, 4.88, 5.13];

  const baseline = 35;
  const equivalent = useMemo(() => currentRatio * (tire / baseline), [currentRatio, tire]);
  const rpmAt = (gear) => (65 * gear * transRatio * 336) / tire;
  const speedAt = (gear) => (rpm * tire) / (gear * transRatio * 336);

  const closest = ratios.reduce((a, b) => Math.abs(b - equivalent) < Math.abs(a - equivalent) ? b : a);

  return (
    <div className="min-h-screen bg-zinc-950 text-zinc-100 p-6 md:p-10">
      <div className="max-w-5xl mx-auto space-y-6">
        <div>
          <p className="text-orange-400 font-semibold tracking-wide">JEEP JLU</p>
          <h1 className="text-3xl md:text-5xl font-bold">Gear Ratio Calculator</h1>
          <p className="text-zinc-400 mt-2">Built around your current setup: 35-inch tires and 3.75 axle gears.</p>
        </div>

        <div className="grid md:grid-cols-3 gap-4">
          <Card className="bg-zinc-900 border-zinc-800 text-white"><CardContent className="p-5">
            <label className="text-sm text-zinc-400">Tire diameter</label>
            <div className="flex gap-2 mt-3">
              {[35,37].map(v => <Button key={v} onClick={() => setTire(v)} className={tire===v ? "bg-orange-500 hover:bg-orange-600" : "bg-zinc-700 hover:bg-zinc-600"}>{v}&quot;</Button>)}
            </div>
          </CardContent></Card>

          <Card className="bg-zinc-900 border-zinc-800 text-white"><CardContent className="p-5">
            <label className="text-sm text-zinc-400">Current axle ratio</label>
            <input type="number" step="0.01" value={currentRatio} onChange={e=>setCurrentRatio(Number(e.target.value))} className="mt-3 w-full rounded-xl bg-zinc-800 p-3 border border-zinc-700" />
          </CardContent></Card>

          <Card className="bg-zinc-900 border-zinc-800 text-white"><CardContent className="p-5">
            <label className="text-sm text-zinc-400">Top-gear transmission ratio</label>
            <input type="number" step="0.01" value={transRatio} onChange={e=>setTransRatio(Number(e.target.value))} className="mt-3 w-full rounded-xl bg-zinc-800 p-3 border border-zinc-700" />
            <p className="text-xs text-zinc-500 mt-2">Adjust this to match your transmission/gear.</p>
          </CardContent></Card>
        </div>

        <Card className="bg-gradient-to-br from-orange-500 to-amber-600 border-0 text-black"><CardContent className="p-6">
          <p className="font-semibold">Equivalent gearing vs. your 35&quot; baseline</p>
          <div className="text-5xl font-bold mt-1">{equivalent.toFixed(2)}:1</div>
          <p className="mt-2">Closest common ratio in this calculator: <b>{closest.toFixed(2)}:1</b></p>
          {tire===37 && <p className="mt-2 text-sm">A 37&quot; tire needs about {equivalent.toFixed(2)} gears to preserve the same gearing feel as {currentRatio.toFixed(2)} gears with 35&quot; tires.</p>}
        </CardContent></Card>

        <div className="grid md:grid-cols-2 gap-4">
          <Card className="bg-zinc-900 border-zinc-800 text-white"><CardContent className="p-5">
            <h2 className="text-xl font-bold">Cruise RPM at 65 MPH</h2>
            <div className="mt-4 space-y-2">
              {ratios.map(g => <div key={g} className="flex justify-between border-b border-zinc-800 pb-2"><span>{g.toFixed(2)}:1</span><b>{Math.round(rpmAt(g)).toLocaleString()} RPM</b></div>)}
            </div>
          </CardContent></Card>

          <Card className="bg-zinc-900 border-zinc-800 text-white"><CardContent className="p-5">
            <h2 className="text-xl font-bold">Speed at Selected RPM</h2>
            <label className="text-sm text-zinc-400 block mt-4">Engine RPM</label>
            <input type="number" step="100" value={rpm} onChange={e=>setRpm(Number(e.target.value))} className="mt-2 mb-4 w-full rounded-xl bg-zinc-800 p-3 border border-zinc-700" />
            <div className="space-y-2">
              {ratios.map(g => <div key={g} className="flex justify-between border-b border-zinc-800 pb-2"><span>{g.toFixed(2)}:1</span><b>{speedAt(g).toFixed(1)} MPH</b></div>)}
            </div>
          </CardContent></Card>
        </div>

        <Card className="bg-zinc-900 border-zinc-800 text-white"><CardContent className="p-5">
          <h2 className="text-xl font-bold">Quick comparison</h2>
          <p className="text-zinc-400 mt-2">Your 3.75 gears on 37&quot; tires would feel approximately like <b className="text-white">{(currentRatio * 35 / 37).toFixed(2)}:1</b> gearing on 35&quot; tires. To restore the same effective gearing after moving from 35&quot; to 37&quot;, the mathematical target is <b className="text-orange-400">{(currentRatio * 37 / 35).toFixed(2)}:1</b>.</p>
          <p className="text-xs text-zinc-500 mt-4">RPM calculations use: RPM = MPH × axle ratio × transmission ratio × 336 ÷ tire diameter. Actual loaded tire diameter, transmission gear, torque-converter behavior, and drivetrain configuration can change real-world RPM.</p>
        </CardContent></Card>
      </div>
    </div>
  );
}
